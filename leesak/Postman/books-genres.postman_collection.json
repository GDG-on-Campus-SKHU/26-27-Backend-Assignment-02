{
  "info": {
    "name": "Leesak Books and Genres API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "SQL & JPA assignment. Actual API assertions, relationship reassignment, errors and cleanup."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "01 Create genre - Literature",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set(\"genreId\", pm.response.json().id);",
              "pm.test(\"Genre name\", () => pm.expect(pm.response.json().name).to.eql(\"문학\"));",
              "console.log(pm.request.method + \" \" + pm.request.url.toString() + \" => \" + pm.response.code + \"\\n\" + pm.response.text());"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/genres",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"문학\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
